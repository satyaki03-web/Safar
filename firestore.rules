rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection (Owners and Drivers)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Vehicles collection
    match /vehicles/{vehicleId} {
      allow read, write: if true;
    }

    // Driver profiles collection (live GPS coordinates, online status, driver credentials)
    match /driverProfiles/{driverId} {
      allow read, write: if true;
    }

    // Rides collection (real-time booking dispatch, matchmaking, OTP start, trip completion)
    match /rides/{rideId} {
      allow read, write: if true;
    }

    // Ratings collection
    match /ratings/{ratingId} {
      allow read, write: if true;
    }

    // Subscriptions collection (weekly/monthly recurring driver bookings)
    match /subscriptions/{subscriptionId} {
      allow read, write: if true;
    }

    // Connection test collection
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
